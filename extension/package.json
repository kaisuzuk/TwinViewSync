{
  "name": "twin-view-sync",
  "version": "1.0.0",
  "description": "Chrome extension for syncing Vue2/Vue3 layout review",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-web-extension": "^4.1.2"
  }
}
